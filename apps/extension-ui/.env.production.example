# Template for apps/extension-ui/.env.production — copy this to
# `.env.production` (git-ignored) and fill in your deployed values:
#
#   cp apps/extension-ui/.env.production.example apps/extension-ui/.env.production
#
# Every VITE_ variable is inlined into the client bundle at build time, so none
# may be secret. Keep development-only overrides (e.g. VITE_USE_MOCK_BRIDGE=true)
# in `.env.development.local` — NOT in `.env.local`, which Vite applies in every
# mode and would ship to production. A production `vite build` fails fast if a
# mock flag or a non-HTTPS origin reaches it (see assertDeployableEnv in
# vite.config.ts).

# Leave false (or unset) for a production build.
VITE_USE_MOCK_BRIDGE=
# The Throttle dashboard origin, e.g. https://app.usethrottle.dev
VITE_THROTTLE_DASHBOARD_ORIGIN=
# The HTTPS origin your deployed Worker serves the connector API from.
VITE_CONNECTOR_API_ORIGIN=
